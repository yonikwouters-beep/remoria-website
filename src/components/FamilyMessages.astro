---
// Privégesprek tussen familie en uitvaartonderneming, met foto's uit de
// gedenkplek als bijlage. Copy volgt de berichten in app.remoria.eu.
const points = [
  {
    title: 'Eén privégesprek per gedenkplek',
    text: 'Enkel de beheerders van de gedenkplek en uw team zien het gesprek. Gasten zien dit niet.',
  },
  {
    title: "Foto's in volle kwaliteit",
    text: "De familie stuurt foto's rechtstreeks uit de gedenkplek door, voor de diavoorstelling of het bidprentje. U downloadt ze per bericht of alles tegelijk als ZIP.",
  },
  {
    title: 'Alles op één plek',
    text: "Geen losse mails of WhatsApp-berichten meer: vragen, afspraken en foto's staan samen bij de gedenkplek.",
  },
  {
    title: 'Niets missen',
    text: 'Nieuwe berichten verschijnen meteen, met een melding in het portaal en hoogstens één mail per uur per gesprek.',
  },
];
---

<section class="msgs" id="berichten" aria-labelledby="msgs-heading">
  <div class="msgs__container">
    <div class="msgs__text">
      <p class="msgs__eyebrow">Berichten · Familie en uitvaartonderneming</p>
      <h2 class="msgs__heading" id="msgs-heading">Eenvoudig contact met de familie</h2>
      <p class="msgs__sub">
        Stel de familie een vraag of vraag foto's voor de afscheidsdienst, rechtstreeks
        vanuit uw portaal. De familie antwoordt vanuit de gedenkplek en stuurt de foto's
        mee die ze daar al verzameld heeft.
      </p>

      <ul class="msgs__points">
        {points.map((p) => (
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C6A24B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span><strong>{p.title}.</strong> {p.text}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="msgs__mock" aria-hidden="true">
      <div class="msgs__mock-head">
        <strong>Familie van Marie Peeters</strong>
        <span>Privégesprek · gasten zien dit niet</span>
      </div>

      <div class="bubble bubble--out">
        Mogen we een paar foto's ontvangen voor de diavoorstelling tijdens de afscheidsdienst?
      </div>

      <div class="bubble bubble--in">
        Dit zijn de foto's voor de diavoorstelling, de eerste mag op het bidprentje.
        <div class="bubble__photos">
          <span></span><span></span><span></span><span class="more">+9</span>
        </div>
      </div>

      <div class="msgs__download">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Alle foto's (12) · Download (ZIP)
      </div>
    </div>
  </div>
</section>

<style>
  .msgs {
    background: #F5F2EC;
    padding: clamp(64px, 10vw, 96px) clamp(20px, 4vw, 40px);
  }

  .msgs__container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .msgs__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #C6A24B;
    margin-bottom: 14px;
  }

  .msgs__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: #1E293B;
  }

  .msgs__sub {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #64748B;
    margin-top: 18px;
    max-width: 540px;
  }

  .msgs__points {
    list-style: none;
    margin-top: 26px;
    display: grid;
    gap: 14px;
  }

  .msgs__points li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-family: 'Inter', sans-serif;
    font-size: 14.5px;
    line-height: 1.6;
    color: #475569;
  }

  .msgs__points strong {
    font-weight: 600;
    color: #1E293B;
  }

  .msgs__points svg {
    flex-shrink: 0;
    margin-top: 4px;
  }

  .msgs__mock {
    background: #fff;
    border-radius: 22px;
    padding: 22px;
    box-shadow: 0 18px 48px rgba(30, 41, 59, 0.1);
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-family: 'Inter', sans-serif;
  }

  .msgs__mock-head {
    display: flex;
    flex-direction: column;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(30, 41, 59, 0.08);
  }

  .msgs__mock-head strong {
    font-size: 15px;
    font-weight: 600;
    color: #1E293B;
  }

  .msgs__mock-head span {
    font-size: 12px;
    color: #64748B;
  }

  .bubble {
    max-width: 85%;
    padding: 12px 14px;
    border-radius: 16px;
    font-size: 13.5px;
    line-height: 1.55;
  }

  .bubble--out {
    align-self: flex-end;
    background: #1E293B;
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .bubble--in {
    align-self: flex-start;
    background: #FAF7F2;
    color: #1E293B;
    border-bottom-left-radius: 4px;
  }

  .bubble__photos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin-top: 10px;
  }

  .bubble__photos span {
    aspect-ratio: 1;
    border-radius: 8px;
    background: linear-gradient(135deg, #E9DFC9, #D8C8A4);
  }

  .bubble__photos .more {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1E293B;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
  }

  .msgs__download {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid rgba(198, 162, 75, 0.5);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: #A8832F;
  }

  @media (max-width: 900px) {
    .msgs__container { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
