---
// Remoria Creators — affiliateprogramma. Copy volgt app.remoria.eu/creators;
// de tracking gebeurt op app.remoria.eu/r/<code>, hier is geen script nodig.
const facts = [
  { value: '€20', label: 'per betaald plan' },
  { value: '60 dagen', label: 'telt een klik op je link mee' },
  { value: 'Maandelijks', label: 'uitbetaald op je rekening' },
];
---

<section class="creators" id="creators" aria-labelledby="creators-heading">
  <div class="creators__container">
    <div class="creators__text">
      <p class="creators__eyebrow">Remoria Creators</p>
      <h2 class="creators__heading" id="creators-heading">
        Deel Remoria en verdien €20 per verkocht plan
      </h2>
      <p class="creators__sub">
        Ken je mensen voor wie een plek vol herinneringen aan een dierbare waardevol is?
        Meld je aan, krijg je eigen link en ontvang €20 voor elk plan dat via jouw link
        gekocht wordt. Maandelijks uitbetaald.
      </p>
      <a href="https://app.remoria.eu/creators" class="creators__btn">
        Word creator
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <div class="creators__facts">
      {facts.map((f) => (
        <div class="creators__fact">
          <p class="creators__fact-value">{f.value}</p>
          <p class="creators__fact-label">{f.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .creators {
    background: #FAF7F2;
    padding: clamp(64px, 10vw, 96px) clamp(20px, 4vw, 40px);
  }

  .creators__container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .creators__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #C6A24B;
    margin-bottom: 14px;
  }

  .creators__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: #1E293B;
  }

  .creators__sub {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #64748B;
    margin-top: 18px;
    max-width: 520px;
  }

  .creators__btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 28px;
    padding: 14px 28px;
    background: #1E293B;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 14.5px;
    font-weight: 500;
    border-radius: 999px;
    transition: background-color 0.2s ease, transform 0.18s ease;
  }

  .creators__btn:hover {
    background: #0f172a;
    transform: translateY(-2px);
  }

  .creators__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .creators__fact {
    background: #fff;
    border: 1px solid rgba(30, 41, 59, 0.06);
    border-radius: 18px;
    padding: 22px 18px;
    box-shadow: 0 12px 40px rgba(30, 41, 59, 0.05);
  }

  .creators__fact-value {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 500;
    color: #1E293B;
    line-height: 1.2;
  }

  .creators__fact-label {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.45;
    color: #64748B;
    margin-top: 6px;
  }

  @media (max-width: 900px) {
    .creators__container { grid-template-columns: 1fr; gap: 36px; }
  }

  @media (max-width: 480px) {
    .creators__facts { grid-template-columns: 1fr; }
  }
</style>
