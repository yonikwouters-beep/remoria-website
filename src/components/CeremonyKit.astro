---
// Ceremoniekit — drukklare QR-affiches, tafelkaartjes en beelden voor de
// afscheidsdienst. Copy en formaten volgen de kit in app.remoria.eu.
export interface Props {
  audience?: 'nabestaanden' | 'uitvaartsector';
}

const { audience = 'nabestaanden' } = Astro.props;

const intro =
  audience === 'uitvaartsector'
    ? 'Maak voor elke afscheidsdienst in een paar klikken affiches, tafelkaartjes en beelden met de QR-code van de gedenkplek, met het logo van uw uitvaartonderneming erop. Gasten scannen en delen meteen hun herinnering.'
    : 'Drukklare affiches, tafelkaartjes en beelden met de QR-code van de gedenkplek. Gasten scannen en delen meteen hun herinnering aan jullie dierbare.';

const formats = [
  { name: 'Affiche A3', sub: 'PDF · 29,7 × 42 cm' },
  { name: 'Affiche A4', sub: 'PDF · 21 × 29,7 cm' },
  { name: 'Tafelkaartje A6', sub: 'PDF · 10,5 × 14,8 cm' },
  { name: 'Digitaal staand', sub: 'PNG · voor WhatsApp of rouwbrief' },
  { name: 'Digitaal scherm', sub: 'PNG · 1920 × 1080 voor een scherm' },
];

const points = [
  'Drie stijlen: Klassiek, Sereen en Puur',
  'In het Nederlands, Frans of Engels, met een eigen zin bij de QR-code',
  audience === 'uitvaartsector'
    ? 'Uw eigen logo erop, optioneel met 3 mm afloop voor de drukkerij'
    : 'Optioneel met 3 mm afloop als een drukkerij de affiche op maat snijdt',
  'Open voor gasten rond de ceremonie: 3, 7 of 14 dagen krijgt wie scant meteen toegang, zonder dat elke aanvraag goedgekeurd moet worden',
];
---

<section class="kit" id="ceremoniekit" aria-labelledby="kit-heading">
  <div class="kit__container">
    <div class="kit__text">
      <p class="kit__eyebrow">Ceremoniekit · Voor de afscheidsdienst</p>
      <h2 class="kit__heading" id="kit-heading">Scan en deel je herinnering</h2>
      <p class="kit__sub">{intro}</p>

      <ul class="kit__points">
        {points.map((p) => (
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C6A24B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="kit__side">
      <div class="kit__poster" aria-hidden="true">
        <p class="kit__poster-kicker">In liefdevolle herinnering</p>
        <p class="kit__poster-name">Marie Peeters</p>
        <svg class="kit__poster-qr" viewBox="0 0 21 21" shape-rendering="crispEdges">
          <path fill="#1E293B" d="M0 0h7v7H0zM1 1v5h5V1zM2 2h3v3H2zM14 0h7v7h-7zM15 1v5h5V1zM16 2h3v3h-3zM0 14h7v7H0zM1 15v5h5v-5zM2 16h3v3H2zM8 0h2v2H8zM11 1h2v3h-2zM8 3h2v2H8zM9 6h3v2H9zM8 9h4v2H8zM13 8h2v3h-2zM16 8h5v2h-5zM0 8h3v2H0zM4 9h3v2H4zM9 12h2v3H9zM12 12h3v2h-3zM17 11h2v3h-2zM13 15h2v3h-2zM16 15h5v2h-5zM8 16h3v2H8zM9 19h4v2H9zM17 18h2v3h-2zM20 19h1v2h-1z"/>
        </svg>
        <p class="kit__poster-msg">Scan en deel je herinnering aan Marie</p>
      </div>

      <ul class="kit__formats">
        {formats.map((f) => (
          <li>
            <strong>{f.name}</strong>
            <span>{f.sub}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .kit {
    background: #fff;
    padding: clamp(64px, 10vw, 96px) clamp(20px, 4vw, 40px);
  }

  .kit__container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .kit__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #C6A24B;
    margin-bottom: 14px;
  }

  .kit__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: #1E293B;
  }

  .kit__sub {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #64748B;
    margin-top: 18px;
    max-width: 540px;
  }

  .kit__points {
    list-style: none;
    margin-top: 26px;
    display: grid;
    gap: 12px;
  }

  .kit__points li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-family: 'Inter', sans-serif;
    font-size: 14.5px;
    line-height: 1.6;
    color: #334155;
  }

  .kit__points svg {
    flex-shrink: 0;
    margin-top: 4px;
  }

  .kit__side {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    align-items: center;
  }

  .kit__poster {
    aspect-ratio: 210 / 297;
    background: #F5F2EC;
    border: 1px solid rgba(198, 162, 75, 0.35);
    border-radius: 6px;
    box-shadow: 0 18px 48px rgba(30, 41, 59, 0.12);
    padding: 18px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
  }

  .kit__poster-kicker {
    font-family: 'Inter', sans-serif;
    font-size: 8px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #C6A24B;
  }

  .kit__poster-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 17px;
    color: #1E293B;
  }

  .kit__poster-qr {
    width: 72px;
    height: 72px;
    background: #fff;
    padding: 5px;
    border-radius: 4px;
    margin: 6px 0;
  }

  .kit__poster-msg {
    font-family: 'Inter', sans-serif;
    font-size: 9.5px;
    line-height: 1.4;
    color: #475569;
  }

  .kit__formats {
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .kit__formats li {
    display: flex;
    flex-direction: column;
    background: #FAF7F2;
    border-radius: 12px;
    padding: 10px 14px;
    font-family: 'Inter', sans-serif;
  }

  .kit__formats strong {
    font-size: 14px;
    font-weight: 500;
    color: #1E293B;
  }

  .kit__formats span {
    font-size: 12.5px;
    color: #64748B;
  }

  @media (max-width: 900px) {
    .kit__container { grid-template-columns: 1fr; gap: 40px; }
  }

  @media (max-width: 480px) {
    .kit__side { grid-template-columns: 1fr; }
    .kit__poster { width: 180px; margin: 0 auto; }
  }
</style>
